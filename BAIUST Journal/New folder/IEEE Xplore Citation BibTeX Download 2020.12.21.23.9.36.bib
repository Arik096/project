@INPROCEEDINGS{8554684,
  author={T. {Zahan} and M. {Zafar Iqbal} and M. {Reza Selim} and M. {Shahidur Rahman}},
  booktitle={2018 International Conference on Bangla Speech and Language Processing (ICBSLP)}, 
  title={Connected Component Analysis Based Two Zone Approach for Bangla Character Segmentation}, 
  year={2018},
  volume={},
  number={},
  pages={1-4},
  abstract={In this paper a complete and robust segmentation process for printed Bangla script is presented. This phase is important for language like Bangla in which resources are not easily available. In Bangla OCR system, one of the main challenges is character segmentation. Proper segmentation increases the accuracy of recognition process. Segmentation is difficult as there are more than 300 basic, modified and compound characters in the script and they are topologically connected. Some characters are overlapped. We have used connected component analysis based two zone approach that can addresses all the problems associated with character segmentation of Bangla script with less effort. In our system we have tried to identify the matra line properly. Then using this information we have divided the script into two zones (upper and lower zone). Connected components from each part are then collected by overlooking matra line. Using some heuristics segmented character parts are organized for proper recognition. Proposed method solves the problems of character segmentation in Bangla script and thereby increases the accuracy of segmentation phase that leads to a greater accuracy of overall optical character recognition (OCR) system.},
  keywords={document image processing;image segmentation;natural language processing;optical character recognition;text analysis;optical character recognition system;Bangla character segmentation;complete segmentation process;robust segmentation process;printed Bangla script;Bangla OCR system;connected component analysis based two zone approach;matra line identification;Image segmentation;Optical character recognition software;Compounds;Character recognition;Shape;Text recognition;Integrated optics;OCR;Segmentation;Bangla Language Processing;connected component analysis},
  doi={10.1109/ICBSLP.2018.8554684},
  ISSN={},
  month={Sep.},}
